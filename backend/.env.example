PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Ticketing_system
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
APP_BASE_URL=http://localhost:5173
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASS=your_app_password_here
MAIL_FROM=your_verified_sender@example.com
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_PASSWORD=choose_a_unique_strong_password
# Optional AI drafting provider. Use guided, ollama, or openai.
AI_PROVIDER=guided
# Free local AI option: install Ollama and run `ollama run gemma3:4b` first.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b
# Optional paid cloud AI option. Keep this key on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
